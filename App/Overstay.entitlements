<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Deliberately empty. Overstay is not sandboxed (a sandboxed app cannot inspect or signal other processes) and
	     needs no entitlement: it reads the process table and signals the user's own processes, nothing else. -->
</dict>
</plist>
